{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tracemigo.com/rubric.anchors.v1.json",
  "title": "TraceMigo Rubric Anchors",
  "description": "Grading anchor criteria for dimensional code assessment.",
  "type": "object",
  "required": ["schema_version", "data"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rubric.anchors.v1"
    },
    "data": {
      "type": "object",
      "required": ["levels"],
      "additionalProperties": false,
      "properties": {
        "levels": {
          "type": "object",
          "required": ["0", "1", "2", "3", "4"],
          "additionalProperties": false,
          "properties": {
            "0": { "type": "string", "maxLength": 500 },
            "1": { "type": "string", "maxLength": 500 },
            "2": { "type": "string", "maxLength": 500 },
            "3": { "type": "string", "maxLength": 500 },
            "4": { "type": "string", "maxLength": 500 }
          }
        }
      }
    }
  }
}
