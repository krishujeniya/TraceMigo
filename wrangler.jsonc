{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "tools/edge/gateway.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shared-production-db",
      "database_id": "ce4a313b-69c9-4fc6-8385-b45eeba064df"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "f8b3339a3f154b29bb794f7f32a654ed"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
